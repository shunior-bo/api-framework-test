{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:feature/*)",
      "Bash(git rev-parse *)",
      "Edit(./.agent-work/**)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)"
    ],
    "deny": [
      "Edit(./tools/**)",
      "Edit(./spec/**)",
      "Edit(./.github/**)",
      "Edit(./src/coverage/**)",
      "Edit(./src/fixtures/coverage.fixture.ts)",
      "Edit(./src/fixtures/auth.fixture.ts)",
      "Edit(./CONVENTIONS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./README.md)",
      "Edit(./playwright.config.ts)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./eslint.config.mjs)",
      "Edit(./tsconfig.json)",
      "Edit(./.mcp.json)",
      "Edit(./.claude/**)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge *)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push * -f*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh workflow *)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Edit(./gad.ref.json)",
      "Edit(./gad/**)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -execdir*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Bash(cat /proc/*)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(grep * .env*)",
      "Bash(grep -r * /proc*)"
    ]
  }
}
