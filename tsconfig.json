{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "paths": {
      "@src/*": ["./src/*"],
      "@coverage/*": ["./tools/coverage/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
